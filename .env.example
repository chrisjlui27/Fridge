# Frontend (written to .env.local for you by `npx convex dev`):
# VITE_CONVEX_URL=https://your-deployment-123.convex.cloud

# Backend settings live in Convex, not here. Set them with
#   npx convex env set NAME value        (add --prod for production)
#
# VAPID_PUBLIC_KEY / VAPID_PRIVATE_KEY   web push keys (npx web-push generate-vapid-keys)
# VAPID_SUBJECT                          mailto:you@example.com
# EXPORT_WEBHOOK_URL                     optional: nightly JSON export is POSTed here
# EXPORT_WEBHOOK_SECRET                  optional: sent as "Authorization: Bearer ..."
# ALLOW_NEW_HOUSEHOLDS                   leave unset; "true" lets strangers create households
